{
  "appId": "es.maskfundas.clientes",
  "appName": "MásKFundas Clientes",
  "webDir": "frontend",
  "server": {
    "url": "https://clientes.maskfundas.es/app",
    "cleartext": false,
    "allowNavigation": [
      "clientes.maskfundas.es"
    ]
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1500,
      "backgroundColor": "#0b1938",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0b1938"
    }
  },
  "ios": {
    "scheme": "App",
    "contentInset": "always",
    "preferredContentMode": "mobile"
  }
}
